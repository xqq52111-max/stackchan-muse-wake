diff --git a/firmware/esp32/components/muse/muse_wake.c b/firmware/esp32/components/muse/muse_wake.c
new file mode 100644
index 0000000..79dda7e
--- /dev/null
+++ b/firmware/esp32/components/muse/muse_wake.c
@@ -0,0 +1,271 @@
+/* Copyright 2026 the StackChan K151 Muse port authors. SPDX-License-Identifier: Apache-2.0 */
+#include "sdkconfig.h"
+#include "muse_wake.h"
+#include "muse_afe.h"
+
+#if CONFIG_K151_WAKE_WORD
+
+#include <math.h>
+#include <string.h>
+
+#include "freertos/FreeRTOS.h"
+#include "freertos/stream_buffer.h"
+#include "freertos/task.h"
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "esp_wn_iface.h"
+#include "esp_wn_models.h"
+#include "model_path.h"
+
+#include "muse_audio.h"
+#include "muse_input.h"
+#include "muse_link.h"
+
+#define WAKE_RING_SAMPLES 8000   /* 500 ms of 16 kHz mono */
+/* The codec runs at 30 dB of mic gain, which puts speech at about -8 dBFS and
+ * clips the peaks. The recogniser wants roughly -20 dBFS, so drop one bit per
+ * step here before the ring. */
+#define WAKE_GAIN_SHIFT 1   /* -6 dB: speech peaks ~-20 dBFS at 30 dB mic gain */
+#define WAKE_RATE 16000
+
+static const char *TAG = "muse_wake";
+
+static srmodel_list_t *s_models;
+static const esp_wn_iface_t *s_iface;
+static model_iface_data_t *s_data;
+static StreamBufferHandle_t s_ring;
+static int s_chunk;
+static volatile bool s_ready;
+static volatile uint32_t s_hits;
+
+/* Runs on the voice task: copy and return, never block. */
+static void wake_tap(const int16_t *stereo, size_t frames, void *ctx)
+{
+    static int16_t mono[MUSE_AUDIO_CHUNK];
+    static int64_t last_us;
+    static int64_t sum_l, sum_r;
+    static int counted;
+
+    if (!s_ready || !s_ring) {
+        return;
+    }
+    if (frames > MUSE_AUDIO_CHUNK) {
+        frames = MUSE_AUDIO_CHUNK;
+    }
+    for (size_t i = 0; i < frames; i++) {
+        int32_t l = stereo[2 * i], r = stereo[2 * i + 1];
+        /* Both mics, after the gain shift: one slot alone was near silent on
+         * this unit, so measure which one carries speech before choosing. */
+        mono[i] = (int16_t)(((l + r) / 2) >> WAKE_GAIN_SHIFT);
+        sum_l += l * l;
+        sum_r += r * r;
+    }
+    counted += (int)frames;
+    int64_t now = esp_timer_get_time();
+    if (now - last_us > 5000000) {
+        float l = sqrtf((float)sum_l / (float)counted), r = sqrtf((float)sum_r / (float)counted);
+        ESP_LOGI(TAG, "mics: L %.1f dBFS, R %.1f dBFS", 20.0f * log10f(l / 32768.0f + 1e-9f),
+                 20.0f * log10f(r / 32768.0f + 1e-9f));
+        last_us = now;
+        sum_l = sum_r = 0;
+        counted = 0;
+    }
+    xStreamBufferSend(s_ring, mono, frames * sizeof(int16_t), 0);
+}
+
+static void wake_task(void *arg)
+{
+    (void)arg;
+    const size_t bytes = (size_t)s_chunk * sizeof(int16_t);
+    int16_t *buf = heap_caps_malloc(bytes, MALLOC_CAP_SPIRAM);
+    if (!buf) {
+        ESP_LOGE(TAG, "no PSRAM for the feed buffer");
+        vTaskDelete(NULL);
+        return;
+    }
+    int64_t last_level_us = 0;
+    int64_t last_hit_us = 0;
+    float loudest_db = -120.0f;
+    int loudest_peak = 0;
+    for (;;) {
+        size_t got = 0;
+        while (got < bytes) {
+            got += xStreamBufferReceive(s_ring, (uint8_t *)buf + got, bytes - got, portMAX_DELAY);
+        }
+        int64_t sum = 0;
+        int peak = 0;
+        for (int i = 0; i < s_chunk; i++) {
+            sum += (int32_t)buf[i] * buf[i];
+            int mag = buf[i] < 0 ? -buf[i] : buf[i];
+            peak = mag > peak ? mag : peak;
+        }
+        float db = 20.0f * log10f(sqrtf((float)sum / (float)s_chunk) / 32768.0f + 1e-9f);
+        loudest_db = db > loudest_db ? db : loudest_db;
+        loudest_peak = peak > loudest_peak ? peak : loudest_peak;
+
+        int64_t now = esp_timer_get_time();
+        if (now - last_level_us > 5000000) {
+            last_level_us = now;
+            ESP_LOGI(TAG, "feed: loudest %.1f dBFS, peak %d", loudest_db, loudest_peak);
+            loudest_db = -120.0f;
+            loudest_peak = 0;
+        }
+
+        wakenet_state_t state = s_iface->detect(s_data, buf);
+        if (state == WAKENET_DETECTED && now - last_hit_us > 1500000) {
+            last_hit_us = now;   /* one word lasts about a second; count it once */
+            s_hits++;
+            char *word = s_iface->get_word_name(s_data, 1);   /* WakeNet10 words start at 1 */
+            ESP_LOGI(TAG, "wake word heard: %s (%.1f dBFS, peak %d)", word ? word : "?", db, peak);
+            s_iface->clean(s_data);
+            muse_input_wake_tap();   /* start a hands-free conversation turn */
+        }
+    }
+}
+
+static void log_mem(const char *step)
+{
+    ESP_LOGI(TAG, "%s: int %u (block %u), dma %u (block %u), psram %u", step,
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_DMA),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_DMA),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM));
+}
+
+void muse_wake_start(void)
+{
+    if (s_ready) {
+        return;
+    }
+    log_mem("before model init");
+    s_models = muse_afe_models();
+    if (!s_models) {
+        s_models = esp_srmodel_init("model");
+    }
+    log_mem("after model init");
+    if (!s_models) {
+        ESP_LOGW(TAG, "no model partition, or it holds no model");
+        return;
+    }
+    ESP_LOGI(TAG, "model partition holds %d model(s)", s_models->num);
+    for (int i = 0; i < s_models->num; i++) {
+        ESP_LOGI(TAG, "  %s", s_models->model_name[i]);
+    }
+
+    char *name = esp_srmodel_filter(s_models, ESP_WN_PREFIX, NULL);
+    if (!name) {
+        ESP_LOGE(TAG, "no wake word model in the partition");
+        return;
+    }
+    s_iface = esp_wn_handle_from_name(name);
+    if (!s_iface) {
+        ESP_LOGE(TAG, "no interface for %s", name);
+        return;
+    }
+    s_data = s_iface->create(name, DET_MODE_95);
+    log_mem("after wakenet create");
+    if (!s_data) {
+        ESP_LOGE(TAG, "could not create %s", name);
+        return;
+    }
+    if (s_iface->get_samp_rate(s_data) != WAKE_RATE || s_iface->get_channel_num(s_data) != 1) {
+        ESP_LOGE(TAG, "%s is not 16 kHz mono", name);
+        s_iface->destroy(s_data);
+        s_data = NULL;
+        return;
+    }
+    s_chunk = s_iface->get_samp_chunksize(s_data);
+    ESP_LOGI(TAG, "%s ready: %d samples per detect (%d ms), heap %u internal / %u psram",
+             name, s_chunk, s_chunk * 1000 / WAKE_RATE,
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM));
+    int words = s_iface->get_word_num ? s_iface->get_word_num(s_data) : 0;
+    for (int i = 1; i <= words; i++) {
+        ESP_LOGI(TAG, "word %d: %s", i, s_iface->get_word_name(s_data, i));
+    }
+
+    /* Both in PSRAM: internal RAM is what the display's DMA buffers need, and
+     * there is only a handful of KB of it left once the model is up. */
+    uint8_t *ring_mem = heap_caps_malloc(WAKE_RING_SAMPLES * sizeof(int16_t) + 1, MALLOC_CAP_SPIRAM);
+    StaticStreamBuffer_t *ring_ctl = heap_caps_malloc(sizeof(*ring_ctl), MALLOC_CAP_SPIRAM);
+    if (!ring_mem || !ring_ctl) {
+        ESP_LOGE(TAG, "no PSRAM for the ring buffer");
+        return;
+    }
+    s_ring = xStreamBufferCreateStatic(WAKE_RING_SAMPLES * sizeof(int16_t), sizeof(int16_t), ring_mem, ring_ctl);
+    if (!s_ring) {
+        ESP_LOGE(TAG, "no ring buffer");
+        return;
+    }
+    if (xTaskCreatePinnedToCoreWithCaps(wake_task, "muse_wake", 4096, NULL, 4, NULL, 1, MALLOC_CAP_SPIRAM) != pdPASS) {
+        ESP_LOGE(TAG, "no wake task");
+        return;
+    }
+    muse_audio_set_wake_tap(wake_tap, NULL);
+    s_ready = true;
+}
+
+static void wake_init_task(void *arg)
+{
+    (void)arg;
+    muse_wake_start();
+    vTaskDelete(NULL);
+}
+
+static void wake_waiter(void *arg)
+{
+    (void)arg;
+    /*
+     * Wait for the link for as long as it takes. Bounding this was a mistake:
+     * a boot that landed while Wi-Fi or Muse was slow (a reboot in the night,
+     * a router still waking up) left the wake word off for the rest of that
+     * boot, and nothing on screen said so. The wait is still for registration
+     * to be done, because the model and the microphones cost the internal RAM
+     * that link.register needs.
+     */
+    for (unsigned i = 1;; i++) {
+        if (muse_link_state() == MUSE_LINK_ONLINE) {
+            ESP_LOGI(TAG, "Muse online: starting the wake word engine");
+            /* A fresh task for the model: it needs an internal stack (the cache
+             * freeze in esp_srmodel_init asserts on that), and this waiter's
+             * stack must stay small so link.register keeps its room. */
+            if (xTaskCreatePinnedToCore(wake_init_task, "wake_init", 4096, NULL, 3, NULL, 1) != pdPASS) {
+                ESP_LOGE(TAG, "no init task");
+            }
+            vTaskDelete(NULL);
+            return;
+        }
+        if (i % 120 == 0) {   /* a minute at 500 ms */
+            ESP_LOGW(TAG, "Muse is %s; wake word still waiting",
+                     muse_link_state_name(muse_link_state()));
+        }
+        vTaskDelay(pdMS_TO_TICKS(500));
+    }
+}
+
+void muse_wake_start_later(void)
+{
+    if (s_ready) {
+        return;
+    }
+    /* Small internal stack: it only polls the link state. */
+    if (xTaskCreatePinnedToCore(wake_waiter, "wake_wait", 2048, NULL, 3, NULL, 1) != pdPASS) {
+        ESP_LOGE(TAG, "no waiter task");
+    }
+}
+
+uint32_t muse_wake_hits(void) { return s_hits; }
+
+void *muse_wake_models(void) { return s_models; }
+
+#else
+
+uint32_t muse_wake_hits(void) { return 0; }
+
+void muse_wake_start(void) {}
+void muse_wake_start_later(void) {}
+void *muse_wake_models(void) { return NULL; }
+
+#endif
diff --git a/firmware/esp32/components/muse/muse_wake.h b/firmware/esp32/components/muse/muse_wake.h
new file mode 100644
index 0000000..756f20e
--- /dev/null
+++ b/firmware/esp32/components/muse/muse_wake.h
@@ -0,0 +1,22 @@
+/* Copyright 2026 the StackChan K151 Muse port authors. SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <stdint.h>
+
+/* Starts the wake word engine: loads the model from the "model" partition,
+ * feeds it microphone frames, and starts a conversation turn when the wake word
+ * is heard. Safe to call once, after audio is up. */
+void muse_wake_start(void);
+
+/* Waits for Muse to be online, then starts the engine. The model's working
+ * buffers cost about 17 KB of internal RAM, and link.register needs that room
+ * to build its 5 KB payload, so the engine must not take it first. */
+void muse_wake_start_later(void);
+
+/* Wake words heard since boot (after the debounce). */
+uint32_t muse_wake_hits(void);
+
+/* The model list from the "model" partition, for other esp-sr users (the AFE
+ * probe). void* so this header need not pull in model_path.h. NULL until the
+ * engine has started. */
+void *muse_wake_models(void);

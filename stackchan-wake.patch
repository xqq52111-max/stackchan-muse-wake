diff --git a/firmware/esp32/components/muse/muse_diag.c b/firmware/esp32/components/muse/muse_diag.c
new file mode 100644
index 0000000..e0b258f
--- /dev/null
+++ b/firmware/esp32/components/muse/muse_diag.c
@@ -0,0 +1,142 @@
+/*
+ * Read-only memory audit for the dual-microphone AFE question.
+ *
+ * Answers, on the real firmware and without changing it:
+ *   - how much internal RAM is free, how big the largest free block is, and
+ *     the worst water mark since boot (not just right now);
+ *   - how large a single internal allocation still succeeds, which is what an
+ *     AFE instance would need before it can even initialise;
+ *   - every task's stack headroom and whether that stack is internal or PSRAM.
+ *
+ * Nothing is kept: the probe allocations are freed before it returns.
+ */
+#include "muse_diag.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "esp_heap_caps.h"
+#include "esp_memory_utils.h"
+#include "esp_system.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "sdkconfig.h"
+#if CONFIG_BT_ENABLED
+#include "esp_bt.h"
+#endif
+
+#include "muse_mem.h"
+
+static void line(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+
+static void line(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    vprintf(fmt, ap);
+    va_end(ap);
+    printf("\n");
+    fflush(stdout);
+}
+
+static void heap(const char *name, uint32_t caps)
+{
+    multi_heap_info_t info;
+    heap_caps_get_info(&info, caps);
+    line("@mem.heap %s free=%u block=%u min=%u alloc=%u ablk=%u fblk=%u", name,
+         (unsigned)info.total_free_bytes, (unsigned)info.largest_free_block,
+         (unsigned)heap_caps_get_minimum_free_size(caps),
+         (unsigned)info.total_allocated_bytes, (unsigned)info.allocated_blocks,
+         (unsigned)info.free_blocks);
+}
+
+/* The largest single allocation still possible: AFE needs one shot of these. */
+static void probe(const char *name, uint32_t caps)
+{
+    static const size_t sizes[] = { 96 * 1024, 80 * 1024, 64 * 1024, 48 * 1024, 40 * 1024, 32 * 1024,
+                                    24 * 1024, 16 * 1024, 12 * 1024, 8 * 1024, 4 * 1024, 2 * 1024 };
+    size_t best = 0;
+    for (size_t i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++) {
+        void *p = heap_caps_malloc(sizes[i], caps);
+        if (p) {
+            if (!best) {
+                best = sizes[i];   /* sizes descend: the first success is the largest */
+            }
+            free(p);
+        }
+    }
+    line("@mem.probe %s largest_single=%uK", name, (unsigned)(best / 1024));
+}
+
+static void tasks(void)
+{
+    UBaseType_t n = uxTaskGetNumberOfTasks() + 4;
+    TaskStatus_t *st = heap_caps_malloc(n * sizeof(TaskStatus_t), MUSE_BIG_CAPS);
+    if (!st) {
+        line("@mem.tasks none (no memory for the table)");
+        return;
+    }
+    n = uxTaskGetSystemState(st, n, NULL);
+    line("@mem.tasks count=%u", (unsigned)n);
+    for (UBaseType_t i = 0; i < n; i++) {
+        const char *where = st[i].pxStackBase ? (esp_ptr_internal(st[i].pxStackBase) ? "int" : "psram") : "?";
+        int core = -1;
+#if CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID
+        core = (int)st[i].xCoreID;
+#endif
+        line("@mem.task %-16s prio=%-2u core=%d hwm=%u stack=%s", st[i].pcTaskName, (unsigned)st[i].uxCurrentPriority,
+             core, (unsigned)st[i].usStackHighWaterMark, where);
+    }
+    free(st);
+}
+
+/* Weak: the BLE server lives in main, which this component must not depend on. */
+extern void ble_server_full_shutdown(void) __attribute__((weak));
+
+/*
+ * Releases the whole Bluetooth stack (NimBLE host + controller + memory pools)
+ * and prints the heap on both sides, so the reclaim is measured and not assumed.
+ * BLE setup needs a reboot afterwards; nothing else uses Bluetooth.
+ */
+void muse_diag_bt_off(void)
+{
+    line("@bt.before");
+    heap("int", MALLOC_CAP_INTERNAL);
+    heap("dma", MALLOC_CAP_DMA);
+    heap("psram", MALLOC_CAP_SPIRAM);
+    probe("int", MALLOC_CAP_INTERNAL);
+    if (!ble_server_full_shutdown) {
+        line("@bt.none no BLE server linked");
+        return;
+    }
+    ble_server_full_shutdown();
+    vTaskDelay(pdMS_TO_TICKS(300));
+    line("@bt.after");
+    heap("int", MALLOC_CAP_INTERNAL);
+    heap("dma", MALLOC_CAP_DMA);
+    heap("psram", MALLOC_CAP_SPIRAM);
+    probe("int", MALLOC_CAP_INTERNAL);
+#if CONFIG_BT_ENABLED
+    line("@bt.status controller=%d", (int)esp_bt_controller_get_status());
+#endif
+}
+
+void muse_diag_mem(void)
+{
+    line("@mem.begin heap=%u min=%u", (unsigned)esp_get_free_heap_size(),
+         (unsigned)esp_get_minimum_free_heap_size());
+    line("@mem.total int=%uK dma=%uK psram=%uK", (unsigned)(heap_caps_get_total_size(MALLOC_CAP_INTERNAL) / 1024),
+         (unsigned)(heap_caps_get_total_size(MALLOC_CAP_DMA) / 1024),
+         (unsigned)(heap_caps_get_total_size(MALLOC_CAP_SPIRAM) / 1024));
+    heap("int", MALLOC_CAP_INTERNAL);
+    heap("dma", MALLOC_CAP_DMA);
+    heap("psram", MALLOC_CAP_SPIRAM);
+    probe("int", MALLOC_CAP_INTERNAL);
+    probe("dma", MALLOC_CAP_DMA);
+#if CONFIG_BT_ENABLED
+    line("@mem.bt controller=%d", (int)esp_bt_controller_get_status());
+#endif
+    tasks();
+    line("@mem.end");
+}

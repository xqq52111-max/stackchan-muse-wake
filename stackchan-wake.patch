+
     config MUSE_TTS_MINIMAX_VOICE
         string "MiniMax voice"
         depends on MUSE_TTS_MINIMAX
@@ -287,4 +298,45 @@ menu "Muse"
             them. Needs PSRAM. Without it, voice notes go over Home Link's own
             session to its paired VM and replies are shown as text.
 
+    config K151_WAKE_WORD
+        bool "K151 wake word (experimental)"
+        depends on MUSE_ENABLED && MUSE_BOARD_M5STACK_STACKCHAN && SPIRAM
+        default n
+        help
+            Adds the ESP-SR wake word engine to the StackChan build. Pulls in
+            espressif/esp-sr and expects a "model" data partition (2 MiB at
+            0x830000) holding the wake word model. Off by default: without it
+            nothing from ESP-SR is linked and the firmware behaves as before.
+
+
+    config K151_BENCH_NO_BT
+        bool "Bench: do not start Bluetooth"
+        depends on MUSE_ENABLED && MUSE_BOARD_M5STACK_STACKCHAN
+        default n
+        help
+            Debug builds only. Skips ble_server_start(), leaving the ~39 KB
+            Bluetooth holds free for the display's DMA buffers, so a bench
+            build with more static RAM can still boot. Phone setup stops
+            working until this is turned off again.
+
+    config K151_AFE_RESIDENT
+        bool "K151: keep the esp-sr AFE resident (experimental)"
+        depends on K151_WAKE_WORD
+        default n
+        help
+            Creates the esp-sr AFE once during boot, after the display and
+            before the radio connects, and keeps it: two microphones, noise
+            suppression, echo cancellation and its own wake word. Costs
+            ~17 KB internal RAM and ~900 KB PSRAM with
+            AFE_MEMORY_ALLOC_MORE_PSRAM. Nothing is fed to it yet; the
+            standalone WakeNet engine still does the wake word.
+
+    config K151_AFE_AEC
+        bool "K151: echo cancellation inside the AFE"
+        depends on K151_AFE_RESIDENT
+        default n
+        help
+            Keeps the AEC stage in the AFE pipeline. It needs the playback
+            reference fed as the third channel and a delay calibration to be
+            worth anything, so it is off until that work is done.
 endmenu

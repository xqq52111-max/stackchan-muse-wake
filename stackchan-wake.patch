diff --git a/firmware/esp32/components/muse/muse_afe.c b/firmware/esp32/components/muse/muse_afe.c
new file mode 100644
index 0000000..f939edd
--- /dev/null
+++ b/firmware/esp32/components/muse/muse_afe.c
@@ -0,0 +1,317 @@
+/*
+ * The AFE, resident: two microphones, spatial enhancement (beam forming and
+ * blind source separation) and a WebRTC voice activity detector, from esp-sr.
+ *
+ * The processing runs on its own task pinned to core 0, away from the audio and
+ * UI core: feed() and fetch() are the expensive calls, and running them inside
+ * the voice task made the animation stutter and the recording drop frames (the
+ * detector then "heard" silence and ended the turn early). The voice task only
+ * pushes raw microphone frames in and pulls enhanced frames out.
+ *
+ * Everything large lives in PSRAM (AFE_MEMORY_ALLOC_MORE_PSRAM): measured on
+ * this board, ~2 KB of internal RAM and ~390 KB of PSRAM for the two-mic
+ * pipeline, against ~49 KB internal when the allocator balances the two.
+ */
+#include "sdkconfig.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#if CONFIG_K151_WAKE_WORD && CONFIG_K151_AFE_RESIDENT
+
+#include <stdio.h>
+#include <string.h>
+
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/idf_additions.h"
+#include "freertos/stream_buffer.h"
+#include "freertos/task.h"
+#include "model_path.h"
+#include "esp_afe_config.h"
+#include "esp_afe_sr_iface.h"
+#include "esp_afe_sr_models.h"
+
+#include "muse_afe.h"
+#include "muse_mem.h"
+
+static const char *TAG = "muse_afe";
+
+/* Room the rest of the firmware needs after the AFE is in. */
+#define AFE_KEEP_FREE_INT  ((size_t)12 * 1024)
+#define AFE_KEEP_BLOCK_INT ((size_t)6 * 1024)
+/* The tunnel opens only with 16 KB of DMA-capable RAM in reserve. */
+#define AFE_KEEP_FREE_DMA  ((size_t)20 * 1024)
+
+/* Raw stereo in (one second), enhanced mono out (half a second). */
+#define AFE_IN_SAMPLES  (16000 * 2)
+#define AFE_OUT_SAMPLES 8000
+
+static afe_config_t *s_cfg;
+static esp_afe_sr_data_t *s_afe;
+static void *s_models;
+static const esp_afe_sr_iface_t *s_iface;
+
+static StreamBufferHandle_t s_in;    /* interleaved stereo */
+static StreamBufferHandle_t s_out;   /* enhanced mono */
+static int16_t *s_feed;              /* one feed frame, interleaved */
+static int s_feed_chunk;
+static int s_feed_chan;
+
+#if CONFIG_K151_AFE_AEC
+/* Playback reference for the echo canceller, pushed by muse_audio_write(). */
+#define AFE_REF_SAMPLES 16384
+static int16_t *s_ref;
+static int s_ref_head, s_ref_tail;
+static volatile int64_t s_ref_last_us;
+#endif
+
+static void log_heap(const char *when)
+{
+    ESP_LOGI(TAG, "%s: int %u/%u, psram %u/%u", when,
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM));
+}
+
+static void afe_task(void *arg);
+
+esp_err_t muse_afe_start(void)
+{
+    if (s_afe) {
+        return ESP_OK;
+    }
+    if (!s_models) {
+        s_models = esp_srmodel_init("model");
+    }
+    if (!s_models) {
+        ESP_LOGE(TAG, "no models in the model partition");
+        return ESP_ERR_NOT_FOUND;
+    }
+    log_heap("before");
+    /* Without echo cancellation there is no playback reference to cancel, and
+     * a third, all-zero channel only gives the source separator something to
+     * lock onto: the two microphones alone are the honest input. */
+#if CONFIG_K151_AFE_AEC
+    const char *input_format = "MMR";
+#else
+    const char *input_format = "MM";
+#endif
+    s_cfg = afe_config_init(input_format, (srmodel_list_t *)s_models, AFE_TYPE_SR, AFE_MODE_LOW_COST);
+    if (!s_cfg) {
+        ESP_LOGE(TAG, "afe_config_init failed");
+        return ESP_FAIL;
+    }
+    /* The difference between fitting and not: a couple of KB internal here
+     * against tens when the allocator balances the two. */
+    s_cfg->memory_alloc_mode = AFE_MEMORY_ALLOC_MORE_PSRAM;
+#if !CONFIG_K151_AFE_AEC
+    s_cfg->aec_init = false;
+#endif
+    s_cfg->wakenet_init = false;   /* the standalone WakeNet owns the wake word */
+    s_cfg->wakenet_model_name = NULL;
+    s_cfg->wakenet_model_name_2 = NULL;
+    /* No AGC: its gain creeps up during silence until the output clips, which
+     * hides the end of speech from the detector (the turn then runs to the 15 s
+     * cap) and leaves the transcript nothing to work with. Levels are handled
+     * where the note is recorded instead. */
+    s_cfg->agc_init = false;
+    const esp_afe_sr_iface_t *iface = esp_afe_handle_from_config(s_cfg);
+    if (!iface || !iface->create_from_config) {
+        ESP_LOGE(TAG, "no AFE interface");
+        return ESP_FAIL;
+    }
+    s_iface = iface;
+    s_afe = iface->create_from_config(s_cfg);
+    log_heap("after");
+    if (!s_afe) {
+        ESP_LOGE(TAG, "AFE could not be created");
+        return ESP_ERR_NO_MEM;
+    }
+    /* link.register builds a ~5 KB JSON in one internal block, and the tunnel
+     * cannot come up without it. An AFE that costs the radio is not worth
+     * having: give the memory back rather than ship a mute robot. */
+    size_t free_int = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+    size_t block_int = heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL);
+    size_t free_dma = heap_caps_get_free_size(MALLOC_CAP_DMA);
+    if (free_int < AFE_KEEP_FREE_INT || block_int < AFE_KEEP_BLOCK_INT || free_dma < AFE_KEEP_FREE_DMA) {
+        ESP_LOGW(TAG, "dropped: %u B internal (%u B block), %u B DMA left for the radio",
+                 (unsigned)free_int, (unsigned)block_int, (unsigned)free_dma);
+        iface->destroy(s_afe);
+        s_afe = NULL;
+        afe_config_free(s_cfg);
+        s_cfg = NULL;
+        log_heap("released");
+        return ESP_ERR_NO_MEM;
+    }
+
+    s_feed_chunk = iface->get_feed_chunksize(s_afe);
+    s_feed_chan = iface->get_feed_channel_num ? iface->get_feed_channel_num(s_afe) : 2;
+    if (s_feed_chan < 2) {
+        s_feed_chan = 2;
+    }
+    s_feed = heap_caps_malloc((size_t)s_feed_chunk * s_feed_chan * sizeof(int16_t), MALLOC_CAP_SPIRAM);
+    s_in = xStreamBufferCreateWithCaps(AFE_IN_SAMPLES * sizeof(int16_t), sizeof(int16_t), MALLOC_CAP_SPIRAM);
+    s_out = xStreamBufferCreateWithCaps(AFE_OUT_SAMPLES * sizeof(int16_t), sizeof(int16_t), MALLOC_CAP_SPIRAM);
+#if CONFIG_K151_AFE_AEC
+    if (s_feed_chan > 2) {
+        s_ref = heap_caps_malloc(AFE_REF_SAMPLES * sizeof(int16_t), MALLOC_CAP_SPIRAM);
+        s_ref_head = s_ref_tail = 0;
+    }
+#endif
+    if (!s_feed || !s_in || !s_out) {
+        ESP_LOGE(TAG, "no PSRAM for the AFE buffers");
+        iface->destroy(s_afe);
+        s_afe = NULL;
+        afe_config_free(s_cfg);
+        s_cfg = NULL;
+        return ESP_ERR_NO_MEM;
+    }
+    /* Core 0: the network lives there, but this task only copies samples and
+     * blocks between frames, while the voice task and the display keep core 1. */
+    if (xTaskCreatePinnedToCoreWithCaps(afe_task, "afe_proc", 4096, NULL, 5, NULL, 0,
+                                       MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        ESP_LOGE(TAG, "no AFE task");
+        iface->destroy(s_afe);
+        s_afe = NULL;
+        return ESP_ERR_NO_MEM;
+    }
+    ESP_LOGI(TAG, "resident: %d Hz, feed %d ch x %d frames, fetch %d ch x %d frames",
+             iface->get_samp_rate(s_afe), s_feed_chan, s_feed_chunk,
+             iface->get_fetch_channel_num ? iface->get_fetch_channel_num(s_afe) : 1,
+             iface->get_fetch_chunksize(s_afe));
+    return ESP_OK;
+}
+
+/* feed() and fetch() live here, off the voice core. */
+static void afe_task(void *arg)
+{
+    (void)arg;
+    const size_t in_bytes = (size_t)s_feed_chunk * 2 * sizeof(int16_t);
+    for (;;) {
+        if (!s_afe || !s_iface) {
+            vTaskDelete(NULL);   /* the AFE was given back to the radio */
+            return;
+        }
+        size_t got = 0;
+        while (got < in_bytes) {
+            got += xStreamBufferReceive(s_in, (uint8_t *)s_feed + got, in_bytes - got, portMAX_DELAY);
+            if (!got) {
+                break;
+            }
+        }
+        if (got < in_bytes) {
+            continue;
+        }
+        /* s_feed holds interleaved L,R. With an echo canceller a third channel
+         * follows each pair; walk backwards so the wider layout never
+         * overwrites a pair that has not been moved yet. */
+        if (s_feed_chan > 2) {
+            for (int i = s_feed_chunk - 1; i >= 0; i--) {
+                int16_t l = s_feed[2 * i], r = s_feed[2 * i + 1];
+                int16_t ref = 0;
+#if CONFIG_K151_AFE_AEC
+                if (s_ref && esp_timer_get_time() - s_ref_last_us < 200000 && s_ref_tail != s_ref_head) {
+                    ref = s_ref[s_ref_tail];
+                    s_ref_tail = (s_ref_tail + 1) % AFE_REF_SAMPLES;
+                }
+#endif
+                s_feed[3 * i + 0] = l;
+                s_feed[3 * i + 1] = r;
+                s_feed[3 * i + 2] = ref;
+            }
+        }
+        s_iface->feed(s_afe, s_feed);
+        afe_fetch_result_t *r = s_iface->fetch ? s_iface->fetch(s_afe) : NULL;
+        if (r && r->ret_value == 0 && r->data && r->data_size > 0) {
+            xStreamBufferSend(s_out, r->data, (size_t)r->data_size, 0);
+        }
+    }
+}
+
+void *muse_afe_models(void)
+{
+    return s_models;
+}
+
+bool muse_afe_ready(void)
+{
+    return s_afe != NULL;
+}
+
+bool muse_afe_active(void)
+{
+    return s_afe != NULL && s_iface != NULL && s_in != NULL && s_out != NULL;
+}
+
+void muse_afe_feed(const int16_t *stereo, size_t frames)
+{
+    if (!muse_afe_active()) {
+        return;
+    }
+    /* Never blocks: if the processor falls behind, the oldest audio is not
+     * worth waiting for, and the microphone reader must keep its pace. */
+    xStreamBufferSend(s_in, stereo, frames * 2 * sizeof(int16_t), 0);
+}
+
+size_t muse_afe_take(int16_t *out, size_t want)
+{
+    if (!muse_afe_active()) {
+        return 0;
+    }
+    size_t n = xStreamBufferReceive(s_out, out, want * sizeof(int16_t), pdMS_TO_TICKS(20));
+    return n / sizeof(int16_t);
+}
+
+void muse_afe_ref(const int16_t *mono, size_t frames)
+{
+#if CONFIG_K151_AFE_AEC
+    if (!s_ref || !muse_afe_active()) {
+        return;
+    }
+    s_ref_last_us = esp_timer_get_time();
+    for (size_t i = 0; i < frames; i++) {
+        s_ref[s_ref_head] = mono[i];
+        s_ref_head = (s_ref_head + 1) % AFE_REF_SAMPLES;
+        if (s_ref_head == s_ref_tail) {   /* full: drop the oldest */
+            s_ref_tail = (s_ref_tail + 1) % AFE_REF_SAMPLES;
+        }
+    }
+#else
+    (void)mono;
+    (void)frames;
+#endif
+}
+
+void muse_afe_yield_to_radio(void)
+{
+    if (!s_afe) {
+        return;
+    }
+    const esp_afe_sr_iface_t *iface = esp_afe_handle_from_config(s_cfg);
+    ESP_LOGW(TAG, "released: the tunnel could not come up with it resident");
+    if (iface && iface->destroy) {
+        iface->destroy(s_afe);
+    }
+    s_afe = NULL;
+    afe_config_free(s_cfg);
+    s_cfg = NULL;
+    log_heap("released");
+}
+
+#else
+
+void *muse_afe_models(void) { return NULL; }
+bool muse_afe_ready(void) { return false; }
+bool muse_afe_active(void) { return false; }
+void muse_afe_feed(const int16_t *stereo, size_t frames) { (void)stereo; (void)frames; }
+size_t muse_afe_take(int16_t *out, size_t want) { (void)out; (void)want; return 0; }
+void muse_afe_ref(const int16_t *mono, size_t frames) { (void)mono; (void)frames; }
+void muse_afe_yield_to_radio(void) {}
+#include "esp_err.h"
+esp_err_t muse_afe_start(void) { return ESP_ERR_NOT_SUPPORTED; }
+
+#endif
diff --git a/firmware/esp32/components/muse/muse_afe.h b/firmware/esp32/components/muse/muse_afe.h
new file mode 100644
index 0000000..c82a2ad
--- /dev/null
+++ b/firmware/esp32/components/muse/muse_afe.h
@@ -0,0 +1,36 @@
+/*
+ * The esp-sr AFE, resident (see muse_afe.c). Off unless K151_AFE_RESIDENT is
+ * set: it needs the wake word engine's esp-sr dependency.
+ */
+#pragma once
+
+#include <stdbool.h>
+
+#include "esp_err.h"
+
+/* Creates the AFE once and keeps it. ESP_OK, or the reason it failed. */
+esp_err_t muse_afe_start(void);
+
+/* True once the AFE is resident. */
+bool muse_afe_ready(void);
+
+/* True when the AFE is resident and can be fed. */
+bool muse_afe_active(void);
+
+/* Pushes one chunk of interleaved stereo mic frames through the AFE. The
+ * enhanced mono output appears in muse_afe_take(). */
+void muse_afe_feed(const int16_t *stereo, size_t frames);
+
+/* Pushes what the speaker is playing, for the echo canceller's reference.
+ * A no-op unless the AFE is resident and AEC is compiled in. */
+void muse_afe_ref(const int16_t *mono, size_t frames);
+
+/* Copies up to `want` enhanced mono samples; returns how many were available. */
+size_t muse_afe_take(int16_t *out, size_t want);
+
+/* Gives the AFE's memory back when the tunnel cannot come up with it resident. */
+void muse_afe_yield_to_radio(void);
+
+/* The model list it loaded, so the standalone WakeNet engine can share it
+ * instead of mapping the partition a second time. NULL if not started. */
+void *muse_afe_models(void);
diff --git a/firmware/esp32/components/muse/muse_afe_probe.c b/firmware/esp32/components/muse/muse_afe_probe.c
new file mode 100644
index 0000000..c86de6c
--- /dev/null
+++ b/firmware/esp32/components/muse/muse_afe_probe.c
@@ -0,0 +1,152 @@
+/*
+ * Bench probe: can esp-sr 2.6.1's AFE be created on this board at all?
+ *
+ * It creates an AFE object from a stock config (MMR, SR, LOW_COST), once per
+ * console command, with the memory allocation strategy chosen by the caller,
+ * records every heap allocation it makes, and destroys the object again. It
+ * never touches the live voice path: no feed, no fetch, no wake engine change.
+ *
+ * Usage over the console (see muse_input.c):
+ *   >afe.try=psram      AFE_MEMORY_ALLOC_MORE_PSRAM
+ *   >afe.try=balance    AFE_MEMORY_ALLOC_INTERNAL_PSRAM_BALANCE
+ *   >afe.try=internal   AFE_MEMORY_ALLOC_MORE_INTERNAL
+ *
+ * Bluetooth is released first (it is only needed for phone setup), because that
+ * is the arrangement the probe is meant to test. A reboot brings Bluetooth back.
+ */
+#include "sdkconfig.h"
+
+#if CONFIG_K151_WAKE_WORD
+
+#include <stdio.h>
+#include <string.h>
+
+#include "esp_heap_caps.h"
+#if CONFIG_HEAP_TRACING
+#include "esp_heap_trace.h"
+#endif
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "model_path.h"
+#include "esp_afe_config.h"
+#include "esp_afe_sr_iface.h"
+#include "esp_afe_sr_models.h"
+
+#include "esp_log.h"
+
+#include "muse_diag.h"
+#include "muse_mem.h"
+#include "muse_wake.h"
+
+#define TRACE_RECORDS 2048
+
+/* Weak: the BLE server lives in main, which this component must not depend on. */
+extern void ble_server_full_shutdown(void) __attribute__((weak));
+extern int esp_bt_controller_get_status(void) __attribute__((weak));
+
+static void heap_line(const char *tag)
+{
+    printf("@afe.heap %-14s int=%u/%u psram=%u/%u\n", tag,
+           (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+           (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL),
+           (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM),
+           (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM));
+    fflush(stdout);
+}
+
+void muse_diag_afe_try(const char *mode_name)
+{
+    afe_memory_alloc_mode_t mode = AFE_MEMORY_ALLOC_MORE_PSRAM;
+    if (!strcmp(mode_name, "balance")) {
+        mode = AFE_MEMORY_ALLOC_INTERNAL_PSRAM_BALANCE;
+    } else if (!strcmp(mode_name, "internal")) {
+        mode = AFE_MEMORY_ALLOC_MORE_INTERNAL;
+    }
+
+    /* The probe tests the arrangement we hope to ship: no Bluetooth. */
+    if (esp_bt_controller_get_status && esp_bt_controller_get_status() == 2 && ble_server_full_shutdown) {
+        printf("@afe.bluetooth released for the probe\n");
+        ble_server_full_shutdown();
+        vTaskDelay(pdMS_TO_TICKS(300));
+    }
+
+    srmodel_list_t *models = (srmodel_list_t *)muse_wake_models();
+    if (!models) {
+        models = esp_srmodel_init("model");
+    }
+    if (!models) {
+        printf("@afe.result no models\n");
+        return;
+    }
+
+#if CONFIG_HEAP_TRACING
+    /* The trace buffer lives in PSRAM so tracing does not itself eat the RAM
+     * it is measuring. */
+    heap_trace_record_t *records = heap_caps_malloc(TRACE_RECORDS * sizeof(heap_trace_record_t), MUSE_BIG_CAPS);
+    if (!records) {
+        printf("@afe.result no trace buffer\n");
+        return;
+    }
+    heap_trace_init_standalone(records, TRACE_RECORDS);
+#endif
+
+    /* The AFE logs a burst while it initialises, and this console drops what it
+     * cannot take: keep it quiet so the numbers below survive. */
+    esp_log_level_t saved_afe = esp_log_level_get("AFE");
+    esp_log_level_t saved_wn = esp_log_level_get("WAKENET10");
+    esp_log_level_t saved_cfg = esp_log_level_get("AFE_CONFIG");
+    esp_log_level_t saved_dl = esp_log_level_get("dl::Model");
+    esp_log_level_set("AFE", ESP_LOG_WARN);
+    esp_log_level_set("WAKENET10", ESP_LOG_WARN);
+    esp_log_level_set("AFE_CONFIG", ESP_LOG_WARN);
+    esp_log_level_set("dl::Model", ESP_LOG_WARN);
+
+    printf("@afe.begin mode=%d (%s)\n", (int)mode, mode_name);
+    fflush(stdout);
+    vTaskDelay(pdMS_TO_TICKS(100));
+    heap_line("before");
+
+#if CONFIG_HEAP_TRACING
+    heap_trace_start(HEAP_TRACE_ALL);
+#endif
+    afe_config_t *cfg = afe_config_init("MMR", models, AFE_TYPE_SR, AFE_MODE_LOW_COST);
+    if (cfg) {
+        cfg->memory_alloc_mode = mode;
+    }
+    const esp_afe_sr_iface_t *iface = cfg ? esp_afe_handle_from_config(cfg) : NULL;
+    esp_afe_sr_data_t *afe = (iface && iface->create_from_config) ? iface->create_from_config(cfg) : NULL;
+#if CONFIG_HEAP_TRACING
+    heap_trace_stop();
+#endif
+
+    heap_line("after create");
+    printf("@afe.result mode=%d cfg=%d iface=%d afe=%d\n", (int)mode, cfg != NULL, iface != NULL, afe != NULL);
+
+    /* Every allocation the AFE made, in order: address tells internal (0x3f...)
+     * from PSRAM (0x3c...), the size is what it asked for. */
+#if CONFIG_HEAP_TRACING
+    heap_trace_dump();
+#endif
+
+    if (afe && iface->destroy) {
+        iface->destroy(afe);
+        heap_line("after destroy");
+    }
+    if (cfg) {
+        afe_config_free(cfg);
+        heap_line("after free");
+    }
+#if CONFIG_HEAP_TRACING
+    heap_trace_init_standalone(NULL, 0);
+    free(records);
+#endif
+    esp_log_level_set("AFE", saved_afe);
+    esp_log_level_set("WAKENET10", saved_wn);
+    esp_log_level_set("AFE_CONFIG", saved_cfg);
+    esp_log_level_set("dl::Model", saved_dl);
+    printf("@afe.end\n");
+    fflush(stdout);
+}
+
+#endif

@@ -726,6 +747,34 @@ void muse_input_hands_free_tap(void)
     post(MUSE_PTT_DOWN, false);   /* no release follows: hands-free turns end on silence */
 }
 
+void muse_input_wake_tap(void)
+{
+    /* The wake word is itself the wake event: no hands-free setting to check
+     * and no sleeping screen to refuse. As with a hands-free tap, no release
+     * follows, so the turn ends on silence. */
+    if (muse_link_state() != MUSE_LINK_ONLINE) {
+        /* Not a turn, but not silence either: a wake word that does nothing at
+         * all reads as a dead robot. Wake the screen and say what is wrong. */
+        ESP_LOGW(TAG, "wake word: Muse is %s", muse_link_state_name(muse_link_state()));
+        if (muse_state_asleep()) {
+            muse_state_set_asleep(false);
+        }
+        muse_state_set_mode(MUSE_MODE_IDLE);
+        muse_state_set_caption("MUSE OFFLINE");
+        return;
+    }
+    if (esp_timer_get_time() < s_taps_held_until_us) {
+        ESP_LOGW(TAG, "wake word ignored: taps held");
+        return;
+    }
+    if (muse_state_asleep()) {
+        ESP_LOGI(TAG, "wake word wakes the screen");
+        muse_state_set_asleep(false);
+    }
+    ESP_LOGI(TAG, "wake word starts a turn");
+    post(MUSE_PTT_DOWN, false);
+}
+
 void muse_input_request_power_off(void)
 {
     s_power_off_requested = true;

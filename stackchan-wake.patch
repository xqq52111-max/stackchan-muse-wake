@@ -0,0 +1,25 @@
+/*
+ * Read-only diagnostics over the console. Nothing here changes behaviour.
+ */
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Prints the internal/PSRAM/DMA water marks, the largest single allocation
+ * still possible, and the task stacks. Triggered by the console command "mem". */
+void muse_diag_mem(void);
+
+/* Releases the Bluetooth stack and prints the heap before and after.
+ * Triggered by the console command "bt.off"; BLE setup needs a reboot later. */
+void muse_diag_bt_off(void);
+
+/* Bench probe: creates an AFE object with the given memory strategy
+ * ("psram", "balance" or "internal"), traces its allocations, destroys it.
+ * Triggered by the console command "afe.try=<mode>". Needs CONFIG_K151_WAKE_WORD. */
+void muse_diag_afe_try(const char *mode_name);
+
+#ifdef __cplusplus
+}
+#endif
